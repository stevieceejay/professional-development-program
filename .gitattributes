# Set default behavior to automatically normalize line endings
* text=auto

# Force specific file types to use LF
*.sh text eol=lf
*.bash text eol=lf

# Force Windows scripts to use CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# Declare files that will always have specific line endings
*.sln text eol=crlf

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.db binary
*.sqlite binary
*.pdf binary
*.docx binary
*.zip binary
*.tar binary
*.gz binary