# Production Environment Template
# Copy to .env on the production host and set real values.

NODE_ENV=production
PORT=5000

# Required: use a cryptographically random value (64+ hex chars recommended)
# Example generator:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_64_plus_char_random_secret

# Optional but recommended in production
DB_PATH=backend/data/project.db
HUGGINGFACE_API_KEY=replace_with_real_key_if_used

# Optional SMTP (if any SMTP_* is set, all are required)
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=no-reply@yourdomain.com
