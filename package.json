{
  "name": "arg-professional-development",
  "version": "1.0.0",
  "description": "The Professional Development Project",
  "main": "server.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "test": "node backend/tools/smoke.js --quick",
    "smoke": "node backend/tools/smoke.js",
    "smoke:auth": "node backend/tools/smoke.js --auth",
    "seed:sample": "node backend/tools/seed-sample.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build:js": "terser ./frontend/public/scripts.js -o ./frontend/public/scripts.min.js -c -m",
    "build:css": "cleancss -o ./frontend/public/style.min.css ./frontend/public/style.css",
    "build:br": "npx brotli-cli compress --glob -q 11 ./frontend/public/*.min.js && npx brotli-cli compress --glob -q 11 ./frontend/public/*.min.css",
    "build": "npm run build:js && npm run build:css && npm run build:br"
  },
  "keywords": [
    "express",
    "node",
    "professional-development"
  ],
  "author": "Stephen",
  "copyright": "Copyright © 2026 Stephen. All Rights Reserved.",
  "license": "UNLICENSED",
  "private": true,
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "connect-sqlite3": "^0.9.16",
    "docx": "^8.5.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "marked": "^5.1.1",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^2.7.0",
    "nodemailer": "^7.0.11",
    "pdfkit": "^0.13.0",
    "pino": "^10.1.1",
    "pino-http": "^11.0.0",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.2",
    "@types/node": "^24.10.8",
    "brotli-cli": "^2.1.1",
    "clean-css-cli": "^5.6.3",
    "csso": "^5.0.5",
    "csso-cli": "^4.0.2",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "nodemon": "^3.0.1",
    "pino-pretty": "^13.1.3",
    "terser": "^5.44.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "connect-sqlite3": {
      "sqlite3": "6.0.1"
    }
  }
}
